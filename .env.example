PORT=4781
SITE_NAME=OpenAPIHub
SITE_TAGLINE=A free directory of public APIs for developers
SITE_ORIGIN=https://your-domain.example

# --- Monetization (leave blank to disable) ---

# Google AdSense publisher ID once approved (ca-pub-XXXXXXXXXXXXXXXX)
ADSENSE_CLIENT=

# Free cookieless analytics. Get a token from
#   dash.cloudflare.com -> Web Analytics -> Add a site
# Paste the token from the generated beacon snippet here.
CF_ANALYTICS_TOKEN=
# Or use Plausible (self-hosted or Plausible Cloud) by setting the domain:
PLAUSIBLE_DOMAIN=

# Affiliate links — replace with YOUR referral URLs so clicks are attributed.
# Vercel:  https://vercel.com/referral -> dashboard -> copy referral link
# Render:  https://render.com/referral
# Supabase: https://supabase.com/partners
AFFILIATE_VERCEL=https://vercel.com
AFFILIATE_RENDER=https://render.com
AFFILIATE_SUPABASE=https://supabase.com
AFFILIATE_SOURCE=openapihub

# Tip-jar (instant payout, no approval). BuyMeACoffee / Ko-fi / GitHub Sponsors.
# Example: DONATE_URL=https://www.buymeacoffee.com/yourhandle
DONATE_URL=
